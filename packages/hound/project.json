{
    "name": "hound",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/hound/src",
    "projectType": "library",
    "tags": [],
    "targets": {
      "lint": {
        "executor": "@nx/eslint:lint",
        "outputs": ["{options.outputFile}"]
      },
      "build": {
        "executor": "@nx/rollup:rollup",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "dist/packages/hound",
          "tsConfig": "packages/hound/tsconfig.lib.json",
          "entryFile": "packages/hound/src/index.ts",
          "external": ["react", "react-dom", "react/jsx-runtime"],
          "rollupConfig": "@nx/react/plugins/bundle-rollup",
          "compiler": "swc",
          "assets": [
            {
              "glob": "packages/hound/README.md",
              "input": ".",
              "output": "."
            }
          ]
        }
      },
      "storybook": {
        "executor": "@nx/storybook:storybook",
        "options": {
          "port": 4400,
          "configDir": "packages/hound/.storybook"
        },
        "configurations": {
          "ci": {
            "quiet": true
          }
        }
      },
      "build-storybook": {
        "executor": "@nx/storybook:build",
        "outputs": ["{options.outputDir}"],
        "options": {
          "outputDir": "dist/storybook/hound",
          "configDir": "packages/hound/.storybook"
        },
        "configurations": {
          "ci": {
            "quiet": true
          }
        }
      }
    }
  }
  