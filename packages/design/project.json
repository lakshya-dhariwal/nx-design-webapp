{
    "name": "design",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/design/src",
    "projectType": "library",
    "tags": ["scope:shared", "type:ui"],
    "targets": {
      "build": {
        "executor": "@nx/rollup:rollup",
        "outputs": ["{workspaceRoot}/dist/packages/design"],
        "options": {
          "config": "packages/design/rollup.config.cjs",
          "main": "packages/design/src/index.ts",
          "outputPath": "dist/packages/design",
          "tsConfig": "packages/design/tsconfig.lib.json",
          "compiler": "babel",
          "external": ["react", "react-dom", "react/jsx-runtime"],
          "format": ["esm"],
          "assets": [
            {
              "input": "packages/design",
              "glob": "README.md",
              "output": "."
            }
          ]
        }
      }
    }
  }
  