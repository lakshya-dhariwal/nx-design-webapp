{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      //* @staq/design paths
      "@mable/hound": ["packages/hound/src/index.ts"],
      "@mable/hound/*": ["packages/hound/src/*"],
      "@/*" : ["packages/hound/src/*"],
  }
  }
}
